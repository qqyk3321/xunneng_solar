# Public browser configuration
# Tally form identifier, taken from the end of https://tally.so/r/<FORM_ID>.
NEXT_PUBLIC_TALLY_FORM_ID=QKQpNX
# Restrict this key to approved browser referrers in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-browser-key
# Restrict this key to Maps Embed API and approved browser referrers.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=your-maps-embed-key

# Server-only configuration — never prefix these names with NEXT_PUBLIC_.
# Restrict this key to server IPs where possible; it is used only by Geocoding API.
GOOGLE_MAPS_SERVER_KEY=your-server-key
# Used by the server-rendered consultation preview to check all three Tally IDs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical website origin (no trailing path). Required for a custom production domain.
# Vercel's own deployment/project domains are allowed automatically on Vercel.
SITE_URL=https://your-website.example

# Browser-safe Supabase Auth configuration for the isolated /auth-preview flow.
# Use the publishable key from the Supabase dashboard; never expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only Upstash configuration: required for production Contact us / FAQ
# protection, and reused by the isolated LOCAL auth-preview prototype.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-read-write-token
# Open the preview using exactly this origin; it also determines email callbacks.
AUTH_PREVIEW_ORIGIN=http://192.168.1.176:3003
