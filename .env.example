# Public browser configuration
# Tally form identifier, taken from the end of https://tally.so/r/<FORM_ID>.
NEXT_PUBLIC_TALLY_FORM_ID=QKQpNX
# Restrict this key to approved browser referrers in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-browser-key

# Server-only configuration — never prefix these names with NEXT_PUBLIC_.
# Restrict this key to server IPs where possible; it is used only by Geocoding API.
GOOGLE_MAPS_SERVER_KEY=your-server-key
# Used by the server-rendered consultation preview to check all three Tally IDs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
