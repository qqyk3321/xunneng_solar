# Website origin (no trailing path). Use your HTTPS domain in Vercel.
# Vercel Production: SITE_URL=https://www.solortide.com
# For local development, use the exact address opened in your browser.
SITE_URL=http://192.168.1.176:3003

# Server-only Contact us / FAQ storage. Never expose the service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used by Vercel Cron to authorize the daily Supabase check.
# Generate a random value of at least 16 characters; never prefix it NEXT_PUBLIC_.
CRON_SECRET=

# Contact us / FAQ / island wishlist: false skips Upstash; true enables it even in development.
# Wishlist uses independent quotas: 5 requests / 10 minutes per source, 100 / hour total.
# Omit/leave empty to preserve defaults: development off, production on.
# When enabled, both Redis credentials below are required; outages remain fail-closed.
CONTACT_UPSTASH_ENABLED=false
# Server-only request rate-limit credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Real .env files must never be committed.

# Native consultation. Configure explicit database and secrets before enabling.
NATIVE_CONSULTATION_ENABLED=false
CONSULTATION_ENVIRONMENT=preview
# Explicit isolated business database; never falls back to SUPABASE_URL.
CONSULTATION_DATABASE_URL=
CONSULTATION_DATABASE_KEY=
# Independent random secrets, >=32 characters. Share the token secret with staff.
CONSULTATION_TOKEN_SECRET=
CONSULTATION_WORKER_SECRET=
CONSULTATION_SITE_URL=
# disabled by default; preview send requires an explicit recipient allowlist.
CONSULTATION_EMAIL_MODE=disabled
CONSULTATION_TEST_EMAILS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEMPLATE_ID=
ANTIGUA_SUPPORT_EMAIL=
DOMINICA_SUPPORT_EMAIL=
